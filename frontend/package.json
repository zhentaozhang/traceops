{
  "name": "traceops-console-workspace",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "pnpm --filter @traceops/console dev",
    "build": "pnpm --filter @traceops/console build",
    "preview": "pnpm --filter @traceops/console preview",
    "typecheck": "pnpm --filter @traceops/console typecheck",
    "lint": "biome check .",
